{
  "name": "kol-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page KOLAB.ID — CodeIgniter 3 + Tailwind CSS. Artikel di-fetch via REST API Campaign (/campaign/articles/feed).",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "css:watch": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "preview": "php -S 127.0.0.1:8087 dev-router.php",
    "dev": "concurrently -n css,preview -c blue,green \"npm:css:watch\" \"npm:preview\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "concurrently": "^9.1.0"
  }
}
